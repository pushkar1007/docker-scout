const StatusBadge = ({ status, summary }) => {
  if (status === 'clean') {
    return (
      <span className="flex items-center gap-2 text-green-400 text-sm font-medium">
        <Shield size={16} /> Clean
      </span>
    );
  }
  if (status === 'high') {
    return (
      <span className="flex items-center gap-2 text-amber-400 text-sm font-medium">
        <AlertTriangle size={16} /> {summary.high} High
      </span>
    );
  }
  if (status === 'critical') {
    return (
      <span className="flex items-center gap-2 text-red-400 text-sm font-medium">
        <AlertOctagon size={16} /> {summary.critical} Critical
      </span>
    );
  }
  return null;
};

const InspectorPanel = ({ image, onClose }) => {
  const [activeTab, setActiveTab] = useState('security');

  if (!image) return null;

  return (
    <div className="w-96 bg-slate-900 border-l border-slate-800 flex flex-col h-full animate-slide-in">
      {/* Header */}
      <div className="p-6 border-b border-slate-800">
        <div className="flex justify-between items-start mb-2">
           <h3 className="text-sm font-semibold text-slate-400 uppercase tracking-wider">Image Inspector</h3>
           <button onClick={onClose} className="text-slate-500 hover:text-white"><X size={16}/></button>
        </div>
        <h2 className="text-xl font-bold text-slate-100 flex items-center gap-2">
          {image.repo}<span className="text-slate-500 text-base font-normal">:{image.tag}</span>
        </h2>
        <div className="mt-2 text-xs font-mono text-slate-500 bg-slate-950 p-2 rounded border border-slate-800 truncate">
          Image ID: {image.id}
        </div>
      </div>

      {/* Tabs */}
      <div className="flex border-b border-slate-800 px-6">
        <button 
          onClick={() => setActiveTab('overview')}
          className={`pb-3 pt-4 text-sm font-medium mr-6 border-b-2 transition-colors ${activeTab === 'overview' ? 'border-blue-500 text-blue-500' : 'border-transparent text-slate-400 hover:text-slate-200'}`}
        >
          Overview & Layers
        </button>
        <button 
          onClick={() => setActiveTab('security')}
          className={`pb-3 pt-4 text-sm font-medium border-b-2 transition-colors ${activeTab === 'security' ? 'border-blue-500 text-blue-500' : 'border-transparent text-slate-400 hover:text-slate-200'}`}
        >
          Security Scan
        </button>
      </div>

      {/* Content */}
      <div className="flex-1 overflow-y-auto p-6">
        {activeTab === 'security' && (
          <>
             <div className="mb-6">
                <h4 className="text-sm font-semibold text-slate-200 mb-1">
                  Found {image.vulnSummary?.critical + image.vulnSummary?.high || 0} Vulnerabilities
                </h4>
                <p className="text-xs text-slate-500">
                  ({image.vulnSummary?.critical || 0} Critical, {image.vulnSummary?.high || 0} High)
                </p>
             </div>

             <div className="space-y-4">
               {image.cves ? image.cves.map((cve) => (
                 <div key={cve.id} className="bg-slate-950 border-l-2 border-red-500 p-4 rounded-r-lg">
                    <div className="flex justify-between items-center mb-1">
                      <span className="text-slate-200 font-bold text-sm">{cve.id}</span>
                      <span className="text-[10px] font-bold text-red-500 bg-red-500/10 px-2 py-0.5 rounded">{cve.sev}</span>
                    </div>
                    <div className="text-xs text-slate-400 mb-2">{cve.package} vulnerability</div>
                    <div className="text-xs text-emerald-400 flex items-center gap-1">
                      Fix: {cve.fix}
                    </div>
                 </div>
               )) : (
                 <div className="text-slate-500 text-sm text-center py-10">
                   No vulnerabilities found.
                 </div>
               )}
             </div>

             <button className="w-full mt-8 bg-slate-800 hover:bg-slate-700 text-slate-300 py-2 rounded-lg text-sm font-medium border border-slate-700 transition-colors">
               Re-Scan Image
             </button>
          </>
        )}

        {activeTab === 'overview' && (
          <div className="space-y-2">
            <h4 className="text-sm font-semibold text-slate-200 mb-4">Layer Composition</h4>
            <div className="flex flex-col-reverse gap-1">
